# GSC Auditor -- Environment Configuration
# ==========================================
# Copy this file to .env and fill in your credentials:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Mac/Linux)

# ===================================
# GOOGLE SEARCH CONSOLE (required)
# ===================================
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create a Service Account -> Download JSON key -> save as credentials.json
# 3. Enable APIs: Search Console API + Indexing API
# 4. In Google Search Console, add the service account email as Owner
# 5. Set GOOGLE_SITE_URL to your GSC property (URL prefix format)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SITE_URL=https://yoursite.com/

# ===================================
# SHOPIFY (required for auto-fix)
# ===================================
# 1. Shopify Admin -> Settings -> Apps -> Develop apps
# 2. Create app "GSC Auditor"
# 3. Configure scopes: write_products, read_products
# 4. Install the app -> copy the Admin API Access Token
# 5. SHOPIFY_STORE is the part before .myshopify.com
SHOPIFY_STORE=your-store-handle
SHOPIFY_ACCESS_TOKEN=YOUR_SHOPIFY_ACCESS_TOKEN
SHOPIFY_API_VERSION=2024-10

# ===================================
# BRAND INFO
# ===================================
BRAND_NAME=Your Brand Name
BRAND_DOMAIN=yoursite.com
COUNTRY_CODE=US
CURRENCY=USD

# ===================================
# OPTIONAL SETTINGS
# ===================================
GSC_AUDIT_DAYS=90
SHOPIFY_RATE_LIMIT_DELAY=0.5
GOOGLE_RATE_LIMIT_DELAY=0.3
SHOPIFY_DRY_RUN=False
VERBOSE_LOGGING=False
FLASK_PORT=5000
REPORTS_DIR=reports
LOGS_DIR=logs
MAX_TITLE_CHARS=60
MIN_DESCRIPTION_WORDS=100
